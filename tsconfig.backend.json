{
  "compilerOptions": {
    "strict": false,
    "strictNullChecks": true,
    "target": "ES2022",
    "lib": [
      "ES2023"
    ],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "backend/**/*.js"
  ],
  "exclude": [
    "backend/node_modules",
    "backend/public"
  ]
}
