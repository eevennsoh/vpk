{
	"hooks": {
		"SessionStart": [
			{
				"matcher": "startup",
				"hooks": [
					{
						"type": "command",
						"command": "cd \"$CLAUDE_PROJECT_DIR\" && exec bash \"$CLAUDE_PROJECT_DIR/.agents/hooks/setup-worktree.sh\""
					}
				]
			}
		]
	},
	"sandbox": {
		"filesystem": {
			"allowRead": [
				"./.env.local.example",
				"./.env.example"
			]
		}
	},
	"worktree": {
		"bgIsolation": "worktree",
		"baseRef": "fresh"
	}
}
