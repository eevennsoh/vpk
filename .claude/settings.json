{
	"hooks": {
		"SessionStart": [
			{
				"matcher": "startup",
				"hooks": [
					{
						"type": "command",
						"command": "cd \"$CLAUDE_PROJECT_DIR\" && exec bash \"$CLAUDE_PROJECT_DIR/.agents/hooks/setup-worktree.sh\""
					}
				]
			}
		]
	},
	"env": {
		"OPENSSL_CONF": "/dev/null"
	},
	"permissions": {
		"deny": [
			"Bash(tmux kill-server:*)",
			"Bash(portless prune:*)"
		]
	},
	"sandbox": {
		"network": {
			"allowLocalBinding": true
		},
		"filesystem": {
			"allowRead": [
				"./.env.local.example",
				"./.env.example"
			]
		}
	},
	"worktree": {
		"bgIsolation": "worktree",
		"baseRef": "fresh"
	}
}
