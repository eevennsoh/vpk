# root-level screenshots/images (keep nested assets tracked)
/*.png
/*.jpg
/*.jpeg
/*.gif
/*.webp
/*.bmp
/*.tif
/*.tiff
/*.avif
/*.heic
/*.heif

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
tmux-*.log

# env files (can opt-in for committing if needed)
.env*
!*.example

# ASAP config (contains private keys - never commit)
.asap-config

# Deploy configuration (contains Docker credentials)
.deploy.local

# Dev process management
.dev-pids
.dev-backend-port
.dev-frontend-port
.dev-rovo-port
.dev-rovo-ports
.dev-rovo-token

# Rovo-created git worktrees
.rovo/worktrees/
.api-routes-backup
.rovo/config.generated.yml
.rovo/config.generated.yml.lock
.rovo/mcp.generated.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude Code local plugin settings
*.local.md
*.local.json

# Additional key/credential patterns
*.key
*.p8
*.pkcs8
*.jks
*.keystore
credentials*
secrets*
.envrc
.netrc
.npmrc.local
.pypirc
*service-account*.json

# Task management plans (project-scoped, source-controlled so Symphony
# workers can read them in cloned workspaces)
/backend/data/

# IDE settings
.idea/
.vscode/settings.json
.vscode/*.log

# ── GSD baseline (auto-generated) ──
.gsd/activity/
.gsd/forensics/
.gsd/runtime/
.claude/worktrees/
.claude/hooks/state/*.log
# Per-checkout preview ports; written by scripts/write-claude-launch-config.js at SessionStart.
.claude/launch.json
.gsd/parallel/
.gsd/auto.lock
.gsd/metrics.json
.gsd/completed-units.json
.gsd/STATE.md
.gsd/gsd.db
.gsd/DISCUSSION-MANIFEST.json
.gsd/milestones/**/*-CONTINUE.md
.gsd/milestones/**/continue.md
Thumbs.db
*.swp
*.swo
*~
.vscode/
*.code-workspace
.env
.env.*
!.env.example
node_modules/
.next/
dist/
# The vendored Rovo Stage Kit ships its built runtime: the finale's wall draws its pieces from it.
!public/1p/rovo-stage-kit/dist/
build/
__pycache__/
*.pyc
.venv/
venv/
target/
vendor/
!components/visual/liquid-metal/vendor/
!components/visual/liquid-metal/vendor/**
# The vendored anatomy kit (MIT, pinned in VENDOR.json) is committed verbatim; vpk-html heroes and its audit run from it.
!.agents/skills/vpk-html/scripts/anatomy/vendor/
!.agents/skills/vpk-html/scripts/anatomy/vendor/**
# The vendored hairline figures (MIT, pinned in VENDOR.json) are committed verbatim; the hairline gallery bundles them.
!.agents/skills/vpk-html/scripts/hairline/vendor/
!.agents/skills/vpk-html/scripts/hairline/vendor/**
# The vendored anatomy-figures WebGL figures (MIT, pinned in VENDOR.json) are committed verbatim; the anatomy-gl engine bundles them.
!.agents/skills/vpk-html/scripts/anatomy-gl/vendor/
!.agents/skills/vpk-html/scripts/anatomy-gl/vendor/**
*.log
coverage/
.cache/
tmp/
.tmp/
