# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/backend/node_modules
/.venv
.pnpm-store/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# local reference clones (TipTap docs/source, etc.)
/.reference/

# browser automation artifacts
/screenshots
/public/screenshots/
--full-page
--out
--output
.playwright-cli/
.bg-shell/
.tmp-agent-browser-home/
.tmp-*.cjs
.tmp-*.mjs
test-results/

# output
/output
/artifacts
/media/videos/tmp*/
/media/videos/**/partial_movie_files/
public/**/hyperframes/.hyperframes/
public/**/hyperframes/.thumbnails/
public/**/hyperframes/.waveform-cache/

# root-level screenshots/images (keep nested assets tracked)
/*.png
/*.jpg
/*.jpeg
/*.gif
/*.webp
/*.bmp
/*.tif
/*.tiff
/*.avif
/*.heic
/*.heif

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
tmux-*.log

# env files (can opt-in for committing if needed)
.env*
!*.example

# ASAP config (contains private keys - never commit)
.asap-config

# Deploy configuration (contains Docker credentials)
.deploy.local

# cmux
cmux.json

# Dev process management
.dev-pids
.dev-backend-port
.dev-frontend-port
.dev-rovo-port
.dev-rovo-ports
.dev-rovo-token

# Rovo-created git worktrees
.rovo/worktrees/
.api-routes-backup
.rovo/config.generated.yml
.rovo/config.generated.yml.lock
.rovo/mcp.generated.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude Code local plugin settings
*.local.md
*.local.json

# Additional key/credential patterns
*.key
*.p8
*.pkcs8
*.jks
*.keystore
credentials*
secrets*
.envrc
.netrc
.npmrc.local
.pypirc
*service-account*.json

# Task management plans (project-scoped, source-controlled so Symphony
# workers can read them in cloned workspaces)
/backend/data/

# IDE settings
.idea/
.vscode/settings.json
.vscode/*.log

# ── GSD baseline (auto-generated) ──
.gsd/activity/
.gsd/forensics/
.gsd/runtime/
.claude/worktrees/
.claude/hooks/state/*.log
# Per-checkout preview ports; written by scripts/write-claude-launch-config.js at SessionStart.
.claude/launch.json
.gsd/parallel/
.gsd/auto.lock
.gsd/metrics.json
.gsd/completed-units.json
.gsd/STATE.md
.gsd/gsd.db
.gsd/DISCUSSION-MANIFEST.json
.gsd/milestones/**/*-CONTINUE.md
.gsd/milestones/**/continue.md
Thumbs.db
*.swp
*.swo
*~
.vscode/
*.code-workspace
.env
.env.*
!.env.example
