#!/usr/bin/env node
"use strict";

const { spawnSync } = require("node:child_process");
const fs = require("node:fs");

const LOCALHOST_PROXY_BYPASS = ["localhost", "127.0.0.1", ".localhost"];

function applyLocalhostProxyBypass(env = process.env) {
	for (const key of ["NO_PROXY", "no_proxy"]) {
		const entries = new Set(
			String(env[key] ?? "")
				.split(",")
				.map((entry) => entry.trim())
				.filter(Boolean),
		);
		for (const entry of LOCALHOST_PROXY_BYPASS) entries.add(entry);
		env[key] = [...entries].join(",");
	}
	return env;
}

applyLocalhostProxyBypass();

if (require.main === module && process.env.VPK_VERIFY_PROXY_BYPASS_READY !== "1") {
	const result = spawnSync(process.execPath, [__filename, ...process.argv.slice(2)], {
		stdio: "inherit",
		env: {
			...process.env,
			VPK_VERIFY_PROXY_BYPASS_READY: "1",
		},
	});
	process.exit(result.status ?? 1);
}

// Subcommand owners load only after the proxy-bypass re-exec above.
const {
	browserSessionId,
	classifyAgentBrowserFailure,
	closeBrowserSessionBestEffort,
	executeBrowserCommand,
	formatBrowserFailure,
	isBrowserSessionStarter,
	parseBrowserTimeoutMs,
	resolveAgentBrowserBin,
	runAgentBrowser,
	writeCapturedOutput,
} = require("./lib/browser.js");
const {
	buildCaptureManifest,
	captureCli,
	formatCaptureSummary,
	manualVerificationRequested,
	parseCaptureArgs,
	runCapture,
} = require("./lib/capture.js");
const { resolveOrigin, targetBrowserArguments } = require("./lib/origin.js");
const { EVIDENCE_DIR, FRONTEND_PORT_FILE, RUN_DIR, readTrimmed } = require("./lib/repo.js");
const {
	collectDoctor,
	parseLaunchReadyTimeoutMs,
	printDoctor,
	readState,
	runPnpm,
	waitForDoctorReady,
	writeState,
} = require("./lib/stack.js");
const { formatWhere, resolveWhere, whereCli } = require("./lib/where.js");

function usage(exitCode = 1) {
	process.stderr.write(`Usage: control-vpk <command>

Commands:
  url                 Print this worktree's origin (Portless, else localhost).
  doctor              Read-only health check. Exit 0 if the frontend is ours and serving.
  doctor --require-backend
                      Also require GET /api/health JSON status=OK.
  launch              Reuse a healthy stack, or start pnpm run dev:tmux:start.
  cleanup             Close the vpk-verify browser session. Stop tmux only if launch started it.
  session             Print the worktree-scoped agent-browser session id.
  evidence-dir        Print the proof artifact directory.
  browser [--] <args> Run agent-browser with the vpk-verify session injected.
  open-target <route> [--headed]
                      First open an exact mapped object route on this worktree.
  capture <route> [--id <label>] [--viewport WxH] [--media light|dark]
          [--variant <id>[=on|off]]... [--wait-text <text>] [--headed] [--strict-a11y]
                      One-command proof: screenshot, ARIA snapshot, console, page
                      errors, a11y audit and manifest.json in the evidence dir.
                      Light media by default. --variant (repeatable) forces a
                      design variant via ?variants= without writing storage.
                      VPK_VERIFY=manual skips the browser.
  where <path|slug|route> [--json]
                      List the routes, importers, feature recipes and Playwright
                      specs to re-check for a source path, catalog slug or route.

`);
	process.exit(exitCode);
}

async function main() {
	const argv = process.argv.slice(2);
	const command = argv[0];
	if (!command || command === "-h" || command === "--help") {
		usage(command ? 0 : 1);
	}

	if (command === "url") {
		const origin = resolveOrigin(readTrimmed(FRONTEND_PORT_FILE));
		if (!origin) {
			process.stderr.write("No origin. Run `control-vpk launch` in this worktree.\n");
			process.exit(1);
		}
		process.stdout.write(`${origin}\n`);
		return;
	}

	if (command === "evidence-dir") {
		process.stdout.write(`${EVIDENCE_DIR}\n`);
		return;
	}

	if (command === "session") {
		process.stdout.write(`${browserSessionId()}\n`);
		return;
	}

	if (command === "capture" || command === "where") {
		const exitCode = command === "capture" ? captureCli(argv.slice(1)) : whereCli(argv.slice(1));
		if (exitCode !== 0) process.exit(exitCode);
		return;
	}

	if (command === "doctor") {
		const report = await collectDoctor();
		printDoctor(report);
		const requireBackend = argv.includes("--require-backend");
		if (!report.ok) process.exit(1);
		if (requireBackend && !report.backendOk) process.exit(1);
		return;
	}

	if (command === "launch") {
		const before = await collectDoctor();
		if (before.ok) {
			writeState({ launchedByVerify: Boolean(readState().launchedByVerify) });
			printDoctor({ ...before, reused: true });
			return;
		}
		const alreadyListening = before.frontendListening;
		runPnpm(["run", "dev:tmux:start"]);
		writeState({ launchedByVerify: !alreadyListening });
		const after = await waitForDoctorReady();
		printDoctor({
			...after,
			reused: alreadyListening,
			launchedByVerify: !alreadyListening,
		});
		if (!after.ok) process.exit(1);
		return;
	}

	if (command === "cleanup") {
		const state = readState();
		closeBrowserSessionBestEffort();
		if (state.launchedByVerify) {
			runPnpm(["run", "dev:tmux:stop"]);
		} else {
			process.stderr.write("Did not start this worktree's stack; leaving it running.\n");
		}
		fs.rmSync(RUN_DIR, { recursive: true, force: true });
		process.stdout.write(`Evidence kept at ${EVIDENCE_DIR}\n`);
		return;
	}

	if (command === "browser" || command === "open-target") {
		if (command === "open-target" && (argv.length < 2 || argv.slice(2).some((arg) => arg !== "--headed"))) {
			throw new Error("Usage: control-vpk open-target <route> [--headed]");
		}
		const forwarded = command === "open-target"
			? targetBrowserArguments(argv[1], { headed: argv.includes("--headed") })
			: argv.slice(1).filter((arg) => arg !== "--");
		if (forwarded.length === 0) {
			process.stderr.write("control-vpk browser requires agent-browser arguments.\n");
			process.exit(1);
		}
		let session;
		try {
			session = browserSessionId();
		} catch (error) {
			const outcome = {
				classification: classifyAgentBrowserFailure(error),
				result: error,
			};
			process.stderr.write(`${formatBrowserFailure(outcome, forwarded)}\n`);
			process.exit(1);
		}
		const outcome = executeBrowserCommand(forwarded, { session });
		writeCapturedOutput(outcome.result);
		if (outcome.recoveredFromStaleSession) {
			process.stderr.write(`Recovered stale agent-browser session ${session}; command succeeded on one bounded retry.\n`);
		}
		if (outcome.classification !== null) {
			process.stderr.write(`${formatBrowserFailure(outcome, forwarded)}\n`);
			process.exit(outcome.result?.status ?? 1);
		}
		return;
	}

	usage(1);
}

if (require.main === module) {
	main().catch((error) => {
		process.stderr.write(`${error.expected ? error.message : error.stack || error.message}\n`);
		process.exit(1);
	});
}

module.exports = {
	applyLocalhostProxyBypass,
	buildCaptureManifest,
	captureCli,
	classifyAgentBrowserFailure,
	executeBrowserCommand,
	formatBrowserFailure,
	formatCaptureSummary,
	formatWhere,
	isBrowserSessionStarter,
	manualVerificationRequested,
	parseBrowserTimeoutMs,
	parseCaptureArgs,
	parseLaunchReadyTimeoutMs,
	resolveAgentBrowserBin,
	resolveWhere,
	runAgentBrowser,
	runCapture,
	targetBrowserArguments,
	waitForDoctorReady,
	whereCli,
};
