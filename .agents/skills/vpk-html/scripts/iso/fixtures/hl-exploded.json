		{ "id": "dot2", "kind": "cylinder", "at": [19, 93, 4], "size": [2.2, 2.2, 1.4], "label": "Minimise" },
		{ "id": "dot3", "kind": "cylinder", "at": [26, 93, 4], "size": [2.2, 2.2, 1.4], "label": "Zoom" },
