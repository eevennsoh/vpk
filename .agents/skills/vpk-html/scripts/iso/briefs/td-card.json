	"camera": { "preset": "dimetric", "scale": "fit" },
	"parts": [
		{ "id": "page", "kind": "slab", "at": [0, 0, 0], "size": [150, 110, 2], "r": 6, "label": "Page", "detail": [{ "type": "dots", "face": "top", "at": [8, 8], "grid": [14, 10], "gap": 10, "size": 0.5 }] },
		{ "id": "surface", "kind": "slab", "at": [25, 12, 2], "size": [100, 86, 3], "r": 5, "label": "Card surface" },
		{ "id": "media", "kind": "slab", "at": [31, 54, 5], "size": [88, 38, 2], "r": 3, "label": "Media", "detail": [{ "type": "line", "face": "top", "points": [[6, 6], [30, 26], [46, 14], [62, 28], [82, 8]] }] },
		{ "id": "title", "kind": "plate", "at": [31, 45, 5], "size": [60, 4, 1], "r": 1, "label": "Title" },
		{ "id": "body-1", "kind": "plate", "at": [31, 38, 5], "size": [80, 2.5, 1], "r": 1, "label": "Body text" },
		{ "id": "body-2", "kind": "plate", "at": [31, 33, 5], "size": [56, 2.5, 1], "r": 1, "label": "Body text, line 2" },
		{ "id": "button", "kind": "box", "at": [87, 18, 5], "size": [32, 9, 3], "r": 3, "label": "Primary button", "detail": [{ "type": "text", "face": "top", "at": [16, 4.5], "text": "Continue", "size": 3, "anchor": "middle" }] }
	],
	"focal": "button",
	"labels": [
		{ "text": "Primary button", "target": "button", "side": "right" },
		{ "text": "Media", "target": "media", "side": "right" },
		{ "text": "Text", "target": "title", "side": "left" },
		{ "text": "Card surface", "target": "surface", "side": "left" },
		{ "text": "Page", "target": "page", "side": "left" }
	],
	"assemble": { "layers": [["page"], ["surface"], ["media", "title", "body-1", "body-2"], ["button"]] },
