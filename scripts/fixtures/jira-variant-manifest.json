			"source": "app/data/{sourceSlug}-contract.test.js",
			"target": "app/data/{targetSlug}-contract.test.js"
		},
		{
			"optional": true,
			"sourceGlob": "tests/projects/{sourceSlug}-*.spec.ts"
		},
		{
			"optional": true,
			"source": "public/illustration/{sourceSlug}",
			"target": "public/illustration/{targetSlug}"
		}
	],
	"rewrites": [
		{
			"from": "{sourcePascal}",
			"to": "{targetPascal}"
		},
		{
			"from": "{sourceUpper}",
			"to": "{targetUpper}"
		},
		{
			"from": "{sourceCamel}",
			"to": "{targetCamel}"
		},
		{
			"from": "{sourceTitle}",
			"to": "{targetTitle}"
		},
		{
			"from": "{sourceSlug}",
			"to": "{targetSlug}"
		},
		{
			"from": "{sourceExperimentalPascal}",
			"to": "{targetExperimentalPascal}"
		},
		{
			"from": "{sourceExperimentalUpper}",
			"to": "{targetExperimentalUpper}"
		},
		{
			"from": "{sourceExperimentalCamel}",
			"to": "{targetExperimentalCamel}"
		},
		{
			"from": "{sourceExperimentalSlug}",
			"to": "{targetExperimentalSlug}"
		},
		{
			"from": "{sourceVersion}",
			"to": "{targetVersion}"
		}
	],
