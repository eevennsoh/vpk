{
	"schemaVersion": 1,
	"family": "jira-golden-journeys",
	"copyTemplates": [
		{
			"source": "components/projects/{sourceSlug}",
			"target": "components/projects/{targetSlug}"
		},
		{
			"source": "components/blocks/jira-work-item/{sourceExperimentalSlug}",
			"target": "components/blocks/jira-work-item/{targetExperimentalSlug}"
		},
		{
			"sourceGlob": "components/blocks/jira-work-item/jira-work-item-{sourceExperimentalSlug}*.test.js"
		},
		{
			"source": "app/{sourceSlug}",
			"target": "app/{targetSlug}"
		},
		{
			"source": "components/website/demos/projects/{sourceSlug}-demo.tsx",
			"target": "components/website/demos/projects/{targetSlug}-demo.tsx"
		},
		{
